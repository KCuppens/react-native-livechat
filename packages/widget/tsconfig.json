{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": { "react": ["./node_modules/preact/compat"], "react-dom": ["./node_modules/preact/compat"], "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"] },
    "skipLibCheck": true
  },
  "include": ["src"]
}
