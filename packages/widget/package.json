{
  "name": "@kobecuppens/livechat-widget",
  "version": "0.0.0",
  "description": "Drop-in <script> help center + live chat widget for any website",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/widget.js",
  "jsdelivr": "./dist/widget.js",
  "unpkg": "./dist/widget.js",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.enabled --coverage.provider=istanbul --coverage.reporter=json-summary --coverage.reporter=json --coverage.include=\"src/**\" --coverage.exclude=\"**/*.test.*\" --coverage.exclude=\"**/test-utils.ts\" --coverage.exclude=\"**/__tests__/**\""
  },
  "devDependencies": {
    "@kobecuppens/livechat-core": "workspace:*",
    "@kobecuppens/livechat-react": "workspace:*",
    "happy-dom": "^20.14.5",
    "preact": "^10.29.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KCuppens/react-native-livechat.git",
    "directory": "packages/widget"
  },
  "keywords": [
    "live chat",
    "support",
    "help center",
    "faq",
    "knowledge base",
    "react",
    "react-native",
    "cloudflare"
  ]
}
